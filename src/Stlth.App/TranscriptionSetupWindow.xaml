<Window x:Class="Stlth.App.TranscriptionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <StackPanel Margin="28,24,28,22">

        <TextBlock x:Name="Heading" Style="{StaticResource Title}" />

        <TextBlock x:Name="Explain" Style="{StaticResource Secondary}" Margin="0,0,0,10" />

        <Border Background="#F0F0F2" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
            <TextBlock x:Name="SizeText" Style="{StaticResource Secondary}" />
        </Border>

        <ProgressBar x:Name="Progress"
                     Height="6"
                     Minimum="0"
                     Maximum="1"
                     Margin="0,0,0,10"
                     Visibility="Collapsed" />

        <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button x:Name="InstallButton" IsDefault="True" MinWidth="190" Click="Install_Click" />
        </StackPanel>

    </StackPanel>
</Window>
