<Window x:Class="Stlth.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="490"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <StackPanel Margin="28,24,28,22">

        <TextBlock x:Name="Heading" Style="{StaticResource Title}" />

        <StackPanel Margin="0,0,0,18">
            <TextBlock x:Name="LanguageLabel" Margin="0,0,0,2" />
            <TextBlock x:Name="LanguageHint" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
            <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left"
                      SelectionChanged="Language_Changed">
                <ComboBoxItem Content="Українська" />
                <ComboBoxItem Content="English" />
            </ComboBox>
        </StackPanel>

        <CheckBox x:Name="Autostart" Checked="Save" Unchecked="Save">
            <StackPanel>
                <TextBlock x:Name="AutostartLabel" />
                <TextBlock x:Name="AutostartHint" Style="{StaticResource Secondary}" />
            </StackPanel>
        </CheckBox>

        <CheckBox x:Name="Reminders" Checked="Save" Unchecked="Save">
            <StackPanel>
                <TextBlock x:Name="RemindersLabel" />
                <TextBlock x:Name="RemindersHint" Style="{StaticResource Secondary}" />
            </StackPanel>
        </CheckBox>

        <CheckBox x:Name="Mixdown" Checked="Save" Unchecked="Save">
            <StackPanel>
                <TextBlock x:Name="MixdownLabel" />
                <TextBlock x:Name="MixdownHint" Style="{StaticResource Secondary}" />
            </StackPanel>
        </CheckBox>

        <CheckBox x:Name="AutoTranscribe" Checked="Save" Unchecked="Save">
            <StackPanel>
                <TextBlock x:Name="AutoTranscribeLabel" />
                <TextBlock x:Name="AutoTranscribeHint" Style="{StaticResource Secondary}" />
                <TextBlock x:Name="AutoTranscribeWarning"
                           Style="{StaticResource Secondary}"
                           Foreground="{StaticResource Accent}"
                           Visibility="Collapsed" />
            </StackPanel>
        </CheckBox>

        <Border Background="#F0F0F2" CornerRadius="6" Padding="14,12" Margin="0,6,0,16">
            <StackPanel>
                <TextBlock x:Name="PermissionText" Margin="0,0,0,4" />
                <TextBlock x:Name="StorageText" Style="{StaticResource Secondary}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="FolderButton" Click="OpenFolder_Click" Margin="0,0,10,0" MinWidth="140" />
            <Button x:Name="CloseButton" IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>

    </StackPanel>
</Window>
