<Window x:Class="Stlth.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування — STLTH Recorder"
        SizeToContent="Height"
        Width="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <StackPanel Margin="28,24,28,22">

        <TextBlock Style="{StaticResource Title}" Text="Налаштування" />

        <CheckBox x:Name="Autostart" Checked="Save" Unchecked="Save">
            <StackPanel>
                <TextBlock Text="Запускатися разом із Windows" />
                <TextBlock Style="{StaticResource Secondary}"
                           Text="Застосунок, який треба вмикати руками, не рятує від забутого запису." />
            </StackPanel>
        </CheckBox>

        <CheckBox x:Name="Reminders" Checked="Save" Unchecked="Save">
            <StackPanel>
                <TextBlock Text="Нагадувати про зустрічі" />
                <TextBlock Style="{StaticResource Secondary}"
                           Text="Питає на початку дзвінка і коли запис лишився увімкненим. Ніколи не вмикає і не вимикає його сам." />
            </StackPanel>
        </CheckBox>

        <CheckBox x:Name="Mixdown" Checked="Save" Unchecked="Save">
            <StackPanel>
                <TextBlock Text="Робити зведений файл для прослуховування" />
                <TextBlock Style="{StaticResource Secondary}"
                           Text="session.m4a поруч із доріжками: я ліворуч, співрозмовник праворуч. Вихідні файли лишаються недоторканими." />
            </StackPanel>
        </CheckBox>

        <Border Background="#F0F0F2" CornerRadius="6" Padding="14,12" Margin="0,6,0,16">
            <StackPanel>
                <TextBlock x:Name="PermissionText" Margin="0,0,0,4" />
                <TextBlock x:Name="StorageText" Style="{StaticResource Secondary}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Тека записів" Click="OpenFolder_Click" Margin="0,0,10,0" MinWidth="130" />
            <Button Content="Закрити" IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>

    </StackPanel>
</Window>
