<Window x:Class="Stlth.App.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Почати запис"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <StackPanel Margin="28,24,28,22">

        <TextBlock Style="{StaticResource Title}" Text="Співрозмовник знає про запис?" />

        <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,16">
            Підтвердження і його час зберігаються в meta.json разом із сесією.
            Запис іде лише на цей комп'ютер.
        </TextBlock>

        <Border x:Name="DeviceNote"
                Background="#F0F0F2"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,14">
            <TextBlock x:Name="DeviceText" Style="{StaticResource Secondary}" />
        </Border>

        <Border x:Name="DiskWarning"
                Background="#FDF0E6"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <TextBlock x:Name="DiskText" Style="{StaticResource Secondary}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Скасувати" IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button x:Name="StartButton"
                    Content="Так, почати запис"
                    IsDefault="True"
                    MinWidth="150"
                    Click="Start_Click" />
        </StackPanel>

    </StackPanel>
</Window>
