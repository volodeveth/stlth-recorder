<Window x:Class="Stlth.App.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <StackPanel Margin="28,24,28,22">

        <TextBlock x:Name="Heading" Style="{StaticResource Title}" />

        <TextBlock x:Name="Explain" Style="{StaticResource Secondary}" Margin="0,0,0,16" />

        <Border Background="#F0F0F2" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <TextBlock x:Name="DeviceText" Style="{StaticResource Secondary}" />
        </Border>

        <Border x:Name="DiskWarning"
                Background="#FDF0E6"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,14"
                Visibility="Collapsed">
            <TextBlock x:Name="DiskText" Style="{StaticResource Secondary}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="CancelButton" IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button x:Name="StartButton"
                    IsDefault="True"
                    MinWidth="160"
                    Click="Start_Click" />
        </StackPanel>

    </StackPanel>
</Window>
