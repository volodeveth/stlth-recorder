<Window x:Class="Stlth.App.PermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height"
        Width="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <StackPanel Margin="28,24,28,22">

        <TextBlock x:Name="Heading" Style="{StaticResource Title}" />

        <TextBlock x:Name="Body1" Style="{StaticResource Secondary}" Margin="0,0,0,10" />

        <TextBlock x:Name="Body2" Style="{StaticResource Secondary}" Margin="0,0,0,18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button x:Name="ContinueButton" Click="Continue_Click" Margin="0,0,10,0" MinWidth="180" />
            <Button x:Name="OpenButton" IsDefault="True" MinWidth="180" Click="Open_Click" />
        </StackPanel>

    </StackPanel>
</Window>
